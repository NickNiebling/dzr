FLASK_SECRET_KEY=
# Discord OAuth for Flask HTML is retired; bot token is still required for jobs.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1195850595014299669
CONTENT_API_KEY=
ZWIFT_USERNAME=
ZWIFT_PASSWORD=
# Account that can edit DZR events on zwift.com. Not the roster login above.
ZWIFT_ORGANIZER_USERNAME=
ZWIFT_ORGANIZER_PASSWORD=
OPENAI_KEY=
ZWIFT_CLUB_ID=
ZWIFTPOWER_CLUB_ID=
# Ladder login for /ladder_page; set BOTH values to override the complete Zwift pair.
# If neither is set, uses ZWIFT_USERNAME / ZWIFT_PASSWORD. Partial overrides are rejected.
# LADDER_EMAIL=
# LADDER_PASSWORD=
PORT=8080

# Sentry uses the shared public DSN automatically in production. Optional overrides:
# An explicitly empty DSN disables reporting.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# Optional release identifier, ideally the deployed git SHA.
SENTRY_RELEASE=
